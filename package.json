{
  "name": "@ds.e/core",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lint-staged": "^16.4.0"
  },
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "playgrounds/*"
    ],
    "nohoist": [
      "**/normalize-scss"
    ]
  },
  "scripts": {
    "build": "yarn lerna run build",
    "prepare": "husky install",
    "lint": "stylelint './**/*.scss'",
    "lint:fix": "yarn lint --fix"
  },
  "lint-staged": {
    "packages/scss/**/*.scss": "yarn --cwd packages/scss lint:fix"
  },
  "repository": "git@bitbucket.org:Siecle/ds.e-monorepo.git",
  "author": "Clemens Sietas <siecle@gmx.de>"
}
